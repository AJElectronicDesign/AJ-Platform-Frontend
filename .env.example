# EmailJS — https://www.emailjs.com/
# 1) Create a service (Gmail/Outlook/etc.)
# 2) Create a template with To Email = contact@aj-electronic-design.com
# 3) Template variables: to_email, to_name, from_name, from_email, reply_to, phone, message, subject
# 4) Copy IDs from EmailJS dashboard

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Backend origin for the AJ Platform API (no path, no trailing slash).
# The app calls ${VITE_API_URL}/api/v1. Example: http://localhost:3000
# A trailing /api/v1 is accepted and stripped.
# Vite inlines this at build time. For GitHub Pages, set the repository
# variable VITE_API_URL so the deploy workflow can see it.
# The API must allow CORS from http://localhost:5173 and
# https://ajelectronicdesign.github.io. Auth is a Bearer token, not cookies.
VITE_API_URL=http://localhost:3000

# Dev-only stand-in for the auth API. Works with `npm run dev` only.
# Production builds ignore this flag and do not bundle the mock.
# Leave unset (or false) when the backend is running.
# Demo account: demo@aj-electronic-design.com / mock-password
# limited@aj-electronic-design.com simulates HTTP 429.
# offline@aj-electronic-design.com simulates a network failure.
VITE_AUTH_MOCK=false
